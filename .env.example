# 🛰️ ORBITAL NEXUS - Environment Configuration

# ========================================
# DATABASE CONFIGURATION
# ========================================
DATABASE_URL=postgresql://postgres:orbital_nexus_2024@localhost:5432/orbital_nexus
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orbital_nexus
DB_USER=postgres
DB_PASSWORD=orbital_nexus_2024

# ========================================
# REDIS CONFIGURATION
# ========================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ========================================
# API CONFIGURATION
# ========================================
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_RELOAD=false

# ========================================
# CELESTRAK API
# ========================================
CELESTRAK_BASE_URL=https://celestrak.org
CELESTRAK_API_KEY=
CELESTRAK_RATE_LIMIT=10

# ========================================
# SECURITY
# ========================================
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-this-too
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# ========================================
# LOGGING
# ========================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=logs/orbital-nexus.log

# ========================================
# MONITORING
# ========================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_PASSWORD=orbital_admin_2024

# ========================================
# FRONTEND CONFIGURATION
# ========================================
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000
REACT_APP_MAPBOX_TOKEN=
REACT_APP_GOOGLE_ANALYTICS_ID=

# ========================================
# DOCKER CONFIGURATION
# ========================================
COMPOSE_PROJECT_NAME=orbital-nexus
DOCKER_REGISTRY=ghcr.io/orbital-nexus
IMAGE_TAG=latest

# ========================================
# SSL/TLS
# ========================================
SSL_ENABLED=false
SSL_CERT_PATH=/etc/ssl/certs/cert.pem
SSL_KEY_PATH=/etc/ssl/private/key.pem

# ========================================
# BACKUP CONFIGURATION
# ========================================
BACKUP_ENABLED=true
BACKUP_INTERVAL=24h
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=

# ========================================
# PERFORMANCE
# ========================================
WORKER_CONNECTIONS=1000
MAX_WORKERS=4
KEEP_ALIVE_TIMEOUT=65
CACHE_TTL=300

# ========================================
# FEATURES FLAGS
# ========================================
FEATURE_COLLISION_DETECTION=true
FEATURE_PREDICTIVE_ANALYTICS=true
FEATURE_REAL_TIME_ALERTS=true
FEATURE_ORBITAL_PREDICTION=true

# ========================================
# THIRD-PARTY INTEGRATIONS
# ========================================
SENDGRID_API_KEY=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# ========================================
# DEVELOPMENT ONLY
# ========================================
DEV_MODE=false
DEV_RELOAD=true
DEV_DEBUG=true
DEV_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]